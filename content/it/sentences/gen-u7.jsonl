{"id": "g:it:1796", "text": "Sembrerò giovane con questa giacca?", "tr": {"en": "Will I look young in this jacket?", "nl": "Zie ik er jong uit in dit jasje?"}, "tr_src": {"en": "claude-gen", "nl": "claude-gen"}, "src": "claude-gen (futuro: sembrare futuro.io)", "unit": "u7", "tokens": [{"t": "Sembrerò", "lex": "it:sembrare", "form": "futuro.io"}, {"t": "giovane", "pre": " ", "lex": "it:giovane"}, {"t": "con", "pre": " ", "lex": "it:con"}, {"t": "questa", "pre": " ", "lex": "it:questo.2"}, {"t": "giacca", "pre": " ", "lex": "it:giacca"}, {"t": "?", "is_word": false}]}
{"id": "g:it:1799", "text": "Sembrerò un turista con questo cappello.", "tr": {"en": "I'll look like a tourist in this hat.", "nl": "Met deze hoed lijk ik net een toerist."}, "tr_src": {"en": "claude-gen", "nl": "claude-gen"}, "src": "claude-gen (futuro: sembrare futuro.io)", "unit": "u7", "tokens": [{"t": "Sembrerò", "lex": "it:sembrare", "form": "futuro.io"}, {"t": "un", "pre": " ", "lex": "it:uno.3"}, {"t": "turista", "pre": " ", "lex": "it:turista"}, {"t": "con", "pre": " ", "lex": "it:con"}, {"t": "questo", "pre": " ", "lex": "it:questo"}, {"t": "cappello", "pre": " ", "lex": "it:cappello"}, {"t": ".", "is_word": false}]}
