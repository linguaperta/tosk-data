{"id": "g:it:1489", "text": "Mentre facevamo i compiti, la mamma cucinava.", "tr": {"en": "While we were doing our homework, mum was cooking.", "nl": "Terwijl wij ons huiswerk maakten, kookte mama."}, "tr_src": {"en": "claude-gen", "nl": "claude-gen"}, "src": "claude-gen (imperfetto: fare imperfetto.noi)", "unit": "u14", "tokens": [{"t": "Mentre", "lex": "it:mentre"}, {"t": "facevamo", "pre": " ", "lex": "it:fare", "form": "imperfetto.noi"}, {"t": "i", "pre": " ", "lex": "it:il"}, {"t": "compiti", "pre": " ", "lex": "it:compito", "form": "infl:number.pl"}, {"t": ",", "is_word": false}, {"t": "la", "pre": " ", "lex": "it:la"}, {"t": "mamma", "pre": " ", "lex": "it:mamma", "form": "infl:number.sg"}, {"t": "cucinava", "pre": " ", "lex": "it:cucinare", "form": "imperfetto.lui/lei"}, {"t": ".", "is_word": false}]}
