{"id": "g:it:220", "text": "Qui diventiamo matti!", "tr": {"en": "We're going crazy here!", "nl": "We worden hier gek!"}, "tr_src": {"en": "claude-gen", "nl": "claude-gen"}, "src": "claude-gen (present-are: diventare presente.noi)", "unit": "u14", "tokens": [{"t": "Qui", "lex": "it:qui"}, {"t": "diventiamo", "pre": " ", "lex": "it:diventare", "form": "presente.noi"}, {"t": "matti", "pre": " ", "lex": "it:matto.2"}, {"t": "!", "is_word": false}]}
